# ---------------------------------------------------------------
# Public site
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep "false" until the pre-publication verification report is signed off.
# While false: every page is noindex/nofollow and a discreet preview banner is shown.
NEXT_PUBLIC_LAUNCH_APPROVED=false

# ---------------------------------------------------------------
# Sanity CMS (leave empty to run on the local seed content)
# ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Write token — only needed to run `npm run seed` (never exposed to the browser)
SANITY_WRITE_TOKEN=

# ---------------------------------------------------------------
# Contact form — SMTP delivery to the company's approved address
# ---------------------------------------------------------------
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional spam protection (Cloudflare Turnstile). Honeypot + timing + rate limit are always on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------
# GitHub Pages (static) — contact form via an external service
# ---------------------------------------------------------------
# e.g. https://formspree.io/f/xxxxxxxx  (leave empty on a Node host: /api/contact is used)
NEXT_PUBLIC_FORM_ENDPOINT=
# "true" only if the form service accepts file uploads (Formspree: paid plans)
NEXT_PUBLIC_FORM_ALLOWS_FILES=false
# Custom domain written to out/CNAME, e.g. www.verdanis.tn
CUSTOM_DOMAIN=
